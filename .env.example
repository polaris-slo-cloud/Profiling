# Host paths mounted into the containers (copy to .env and adjust).
# Defaults target the legacy layout; after scripts/migrate_layout.sh use:
#POLARIS_HOST_DATA=./data/samples
#POLARIS_HOST_MODELS=./models
POLARIS_HOST_RESULTS=./results
POLARIS_HOST_FIGURES=./figures

# Per-profile resource estimator used by the api service:
# mean | median | q05 | iqr | skew-adaptive
#POLARIS_ESTIMATOR=q05
